# Server environment variables for local development
# Copy this to server/.env (never commit server/.env!)

PORT=3001
NODE_ENV=development

# MongoDB – leave blank to use in-memory engine (dev only)
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/cognispace?retryWrites=true&w=majority

# JWT secret – change this to a long random string in production!
JWT_SECRET=cognispace_dev_jwt_secret_change_in_production

# Gemini AI key
GEMINI_API_KEY=your_gemini_api_key_here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
