# Copy to .env (never commit it). Everything is optional in development.

PORT=3001
NODE_ENV=development

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Required in production. Leave empty in development to use an embedded in-memory MongoDB.
MONGODB_URI=

# Gemini API key for Copilot. Without it, the Copilot shows a clear "not configured" message.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_DAILY_LIMIT=60

# Comma-separated list of allowed browser origins (your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
# Optional: used when the main model is overloaded (503) or rate limited
GEMINI_FALLBACK_MODEL=

# Password-reset email (Resend). Without a key, reset links are printed to the server log in development.
RESEND_API_KEY=
EMAIL_FROM="CogniSpace <no-reply@yourdomain.com>"
# Public URL of the frontend, used to build reset links (defaults to the first CORS origin)
APP_URL=
